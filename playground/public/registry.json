{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "generic-form",
  "homepage": "https://github.com/vikramsamak/generic-form",
  "items": [
    {
      "name": "generic-form",
      "type": "registry:component",
      "title": "Generic-Form",
      "description": "A highly flexible and configurable form component for ShadCN, powered by React Hook Form and Zod. Easily define fields, validation, layout, and actions with a simple configuration",
      "author": "Vikram Samak",
      "files": [
        {
          "path": "src/generic-form/index.ts",
          "type": "registry:file",
          "target": "src/components/generic-form/index.ts"
        },
        {
          "path": "src/generic-form/form-actions.tsx",
          "type": "registry:component",
          "target": "src/components/generic-form/form-actions.tsx"
        },
        {
          "path": "src/generic-form/form-field-wrapper.tsx",
          "type": "registry:component",
          "target": "src/components/generic-form/form-field-wrapper.tsx"
        },
        {
          "path": "src/generic-form/generic-form.tsx",
          "type": "registry:component",
          "target": "src/components/generic-form/generic-form.tsx"
        },
        {
          "path": "src/generic-form/utils.ts",
          "type": "registry:file",
          "target": "src/components/generic-form/utils.ts"
        },
        {
          "path": "src/generic-form/constants.ts",
          "type": "registry:file",
          "target": "src/components/generic-form/constants.ts"
        },
        {
