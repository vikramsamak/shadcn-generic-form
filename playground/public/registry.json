          "target": "src/types/form-field-wrapper.types.ts"
        },
        {
          "path": "src/types/generic-form.types.ts",
          "type": "registry:file",
          "target": "src/types/generic-form.types.ts"
        }
      ],
      "dependencies": ["@hookform/resolvers", "zod", "react-hook-form"],
      "registryDependencies": ["button", "form", "label"]
    }
  ]
